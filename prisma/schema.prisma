generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  FREE
  PRO
  TEAM
}

enum Horizon {
  TODAY
  THIS_WEEK
  THIS_QUARTER
  ONE_TO_THREE_YEARS
}

enum Stakes {
  LOW
  MEDIUM
  HIGH
}

enum DecisionMode {
  QUICKMOVE
  PLAN
  COURT
}

enum ReceiptStatus {
  OPEN
  LOGGED
  EXPIRED
}

model User {
  id        String    @id @default(cuid())
  email     String?   @unique
  name      String?
  tier      Tier      @default(FREE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  receipts  Receipt[]
  sessions  Session[]
  accounts  Account[]
}

model Receipt {
  id              String        @id @default(cuid())
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  question        String
  horizon         Horizon
  stakes          Stakes
  mode            DecisionMode
  trueNorth       String
  whyBullets      String[]
  altitude        Int
  irreversibility Float
  nciGrade        String?
  driftState      String?
  outcome         Outcome?
  createdAt       DateTime      @default(now())
  reviewDate      DateTime?
  status          ReceiptStatus @default(OPEN)

  @@index([userId])
  @@index([createdAt])
}

model Outcome {
  id          String   @id @default(cuid())
  receiptId   String   @unique
  receipt     Receipt  @relation(fields: [receiptId], references: [id])
  what        String
  matched     Boolean
  regretScore Int
  learning    String?
  loggedAt    DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
