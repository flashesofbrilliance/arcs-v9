{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcs/tabbed-brief/brief.schema.json",
  "title": "Tabbed brief data",
  "description": "All copy for a tabbed-brief page. scripts/tabbed_brief_build.py validates against this file (the stdlib subset shared with precall-brief) and adds the checks JSON Schema cannot say: each plan row has the duty plus one cell per horizon, each plan has one 'know' line per horizon, table rows match their header, tab ids are unique, every action points at a real tab or section, and no em-dashes. Inline marks allowed in any text: [text](https://url) and **bold**. No raw HTML.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "doc_title",
    "storage_key",
    "horizons",
    "meta",
    "overview",
    "tabs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "doc_title": {
      "type": "string",
      "description": "The browser title and the frame's accessible name. Two to five words."
    },
    "storage_key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "description": "localStorage key for the reader's theme choice, one per page."
    },
    "analytics": {
      "type": "boolean",
      "description": "Load Vercel Web Analytics in the repo page (public pages must). The Artifact build never does."
    },
    "horizons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Day marks for every plan on the page, for example [30, 90, 180]."
    },
    "top_line": {
      "type": "string",
      "description": "Optional: a Private chip and one line on who it is for and how it was shared. Leave it out when the meta strip says enough."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prepared_for",
        "from"
      ],
      "properties": {
        "prepared_for": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "headline",
        "tiles",
        "sections"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "headline": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string"
          },
          "description": "One sentence per line."
        },
        "lede": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "One short line each; rendered one per line."
        },
        "next_step": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "lead": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "actions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "tab": {
                "type": "string"
              },
              "section": {
                "type": "string"
              },
              "primary": {
                "type": "boolean"
              }
            }
          }
        },
        "action_note": {
          "type": "string"
        },
        "tiles": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "v",
              "k",
              "note"
            ],
            "properties": {
              "v": {
                "type": "string"
              },
              "k": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "coldread": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "title",
            "block"
          ],
          "description": "The cold-read header (rule 13a, kit 53): never folded, placed after the action row and before any detail.",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "title": {
              "type": "string"
            },
            "block": {
              "$ref": "#/$defs/block"
            }
          }
        },
        "subhead": {
          "type": "string",
          "minLength": 1,
          "description": "Optional H2 line between the headline and the lede (the source of the headline claim)."
        },
        "byline": {
          "type": "string",
          "description": "Optional: the author's name, one line under the headline (kit 27 register). Use it when the wordmark is the only name at the top."
        },
        "bites": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "description": "Optional: kit 55 sound bites in the hero. Real, attributed quotes only, verbatim from where they are published.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "name",
              "role"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "bites_source": {
          "type": "string",
          "description": "Where the quotes are published, as a link."
        },
        "bites_still": {
          "type": "boolean",
          "description": "Optional: show the sound bite whole, with no typing and no timer (one focal point in the hero)."
        }
      }
    },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/tab"
      }
    },
    "pages": {
      "type": "boolean",
      "description": "One page per pane: the overview at the output path, each role beside it (site: <name>-<id>.html served at /<id>; Artifact: <id>.html)."
    },
    "default_theme": {
      "enum": [
        "light",
        "dark"
      ],
      "description": "Optional: the theme a reader sees before choosing one. Light when left out."
    },
    "stack_below": {
      "type": "integer",
      "minimum": 600,
      "maximum": 1440,
      "description": "Width in px below which the tabs fold into the menu and the roles stack. Default 1024. The token tuner's breakpoint slider writes this field in its JSON patch."
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "tagline",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "open": {
          "type": "boolean"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "tab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "name",
        "tagline",
        "headline",
        "lede",
        "units"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "rank": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "headline": {
          "type": "string"
        },
        "lede": {
          "type": "string"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "title",
              "blocks"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                }
              }
            }
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "text"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "p"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "head",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "head": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "chips": {
              "type": "array",
              "items": {
                "enum": [
                  "plain",
                  "cyan",
                  "green",
                  "gold",
                  "red",
                  ""
                ]
              },
              "description": "Optional: one chip colour per row; the row's first cell renders as a kit 28 chip. Gold marks judgment or a limit, never evidence. Plain (no signal colour) for a view the evidence has not settled; green and red mean proven and failed."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "source",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "plan"
            },
            "source": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "know": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cards"
          ],
          "properties": {
            "type": {
              "const": "cards"
            },
            "cards": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "title",
                  "text"
                ],
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "ref": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "list"
            },
            "ordered": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "slots"
          ],
          "properties": {
            "type": {
              "const": "coldread"
            },
            "slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 6,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string"
                }
              }
            },
            "how": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string"
                }
              }
            },
            "read": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "lead",
            "text"
          ],
          "properties": {
            "type": {
              "const": "callout"
            },
            "lead": {
              "type": "string",
              "description": "One or two words in the kit 31 label, for example Limit."
            },
            "text": {
              "type": "string"
            }
          },
          "description": "Kit 31 gold callout: the page's stated limit."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "groups"
          ],
          "description": "Kit 54 signal ledger: grouped rows, each naming the signal it rests on. Tones: plain (unsettled view), cyan (sourced, dated fact), gold (judgment or limit).",
          "properties": {
            "type": {
              "const": "ledger"
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "rows"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "judgment": {
                    "type": "boolean"
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "chip",
                        "signal",
                        "text"
                      ],
                      "properties": {
                        "chip": {
                          "type": "string"
                        },
                        "tone": {
                          "enum": [
                            "plain",
                            "cyan",
                            "gold"
                          ]
                        },
                        "signal": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
