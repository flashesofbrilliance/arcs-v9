{
  "experimentalServices": {
    "web": {
      "entrypoint": ".",
      "routePrefix": "/"
    },
    "sage": {
      "entrypoint": "operators/arcs_api.py",
      "routePrefix": "/svc/sage",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/resume.html"
    }
  ],
  "headers": [
    {
      "source": "/resume.html",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/debrief",
      "schedule": "0 14 * * *"
    }
  ]
}
