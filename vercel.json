{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
      "buildCommand": "bash scripts/vercel-migrate-deploy.sh && npm run build",
      "rewrites": [
        {
          "source": "/resume",
          "destination": "/resume.html"
        },
        {
          "source": "/",
          "has": [
            {
              "type": "host",
              "value": "kelly-interview.arcs.care"
            }
          ],
          "destination": "/kelly-interview.html"
        },
        {
          "source": "/teardown",
          "has": [
            {
              "type": "host",
              "value": "todd-call.arcs.care"
            }
          ],
          "destination": "/todd-teardown.html"
        },
        {
          "source": "/logictree",
          "has": [
            {
              "type": "host",
              "value": "todd-call.arcs.care"
            }
          ],
          "destination": "/todd-logictree.html"
        },
        {
          "source": "/runtime",
          "has": [
            {
              "type": "host",
              "value": "julia.arcs.care"
            }
          ],
          "destination": "/julia-runtime.html"
        },
        {
          "source": "/runtime",
          "has": [
            {
              "type": "host",
              "value": "arcs-v9-git-claude-vercel-ga-services-arcs-care.vercel.app"
            }
          ],
          "destination": "/julia-runtime.html"
        },
        {
          "source": "/",
          "has": [
            {
              "type": "host",
              "value": "arcs-v9-git-claude-vercel-ga-services-arcs-care.vercel.app"
            }
          ],
          "destination": "/julia-runtime.html"
        }
      ],
      "headers": [
        {
          "source": "/resume.html",
          "headers": [
            {
              "key": "X-Frame-Options",
              "value": "SAMEORIGIN"
            }
          ]
        }
      ]
    },
    "sage": {
      "root": "operators/",
      "entrypoint": "arcs_api:app",
      "functions": {
        "arcs_api.py": {
          "maxDuration": 30
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/svc/sage",
      "destination": {
        "service": "sage"
      }
    },
    {
      "source": "/svc/sage/(.*)",
      "destination": {
        "service": "sage"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/debrief",
      "schedule": "0 14 * * *"
    }
  ]
}
