{
  "experimentalServices": {
    "web": {
      "entrypoint": ".",
      "routePrefix": "/"
    },
    "sage": {
      "entrypoint": "operators/arcs_api.py",
      "routePrefix": "/svc/sage",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/resume",
      "destination": "/resume.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "kelly-interview.arcs.care" }],
      "destination": "/kelly-interview.html"
    },
    {
      "source": "/teardown",
      "has": [{ "type": "host", "value": "todd-call.arcs.care" }],
      "destination": "/todd-teardown.html"
    },
    {
      "source": "/logic-tree",
      "has": [{ "type": "host", "value": "todd-call.arcs.care" }],
      "destination": "/todd-logic-tree.html"
    },
    {
      "source": "/runtime",
      "has": [{ "type": "host", "value": "julia.arcs.care" }],
      "destination": "/julia-runtime.html"
    }
  ],
  "headers": [
    {
      "source": "/resume.html",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/debrief",
      "schedule": "0 14 * * *"
    }
  ]
}
