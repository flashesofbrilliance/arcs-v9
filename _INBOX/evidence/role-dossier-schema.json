{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcs.care/schemas/role-dossier-schema-v1.json",
  "title": "Perplexity Scout Role Dossier",
  "description": "Standard intake contract for external market intelligence & JD reconnaissance feeding the ARCS Falsifier and Loki/BAR gauntlet. Designed with a stable core and nullable best-effort extensions.",
  "type": "object",
  "required": [
    "schema_version",
    "dossier_id",
    "retrieved_at",
    "target_role",
    "company",
    "scout_verdict",
    "raw_sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "dossier_id": {
      "type": "string",
      "description": "Unique identifier, format: SCOUT-<company_slug>-<role_slug>-<YYYYMMDD>"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of reconnaissance pass"
    },
    "scout_verdict": {
      "type": "object",
      "required": ["classification", "confidence", "primary_rationale"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["ATTAINABLE", "TRAP", "UNDECIDABLE"],
          "description": "Ternary verdict mapping to ARCS NULL/OM/UNDEFINED logic"
        },
        "confidence": {
          "type": "string",
          "enum": ["HIGH", "MEDIUM", "LOW"]
        },
        "primary_rationale": {
          "type": "string",
          "description": "One concise sentence explaining the ternary verdict"
        },
        "flags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "e.g., 'posting_age_gt_30d', 'repost_pattern_detected', 'aggregator_only', 'salary_transparency_missing'"
        }
      }
    },
    "target_role": {
      "type": "object",
      "required": ["title", "primary_url", "first_seen_days_ago", "cross_listed_on_careers_page"],
      "properties": {
        "title": { "type": "string" },
        "primary_url": { "type": "string", "format": "uri" },
        "first_seen_days_ago": { "type": ["integer", "null"] },
        "repost_count_observed": { "type": ["integer", "null"] },
        "cross_listed_on_careers_page": { "type": "boolean" },
        "raw_jd_text": { "type": ["string", "null"] },
        "salary_range": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "currency": { "type": "string", "default": "USD" },
            "interval": { "type": "string", "enum": ["yearly", "hourly"] }
          }
        }
      }
    },
    "company": {
      "type": "object",
      "required": ["name", "domain"],
      "properties": {
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "headcount_trend": {
          "type": ["string", "null"],
          "enum": ["GROWING", "FLAT", "DECLINING", "MASS_LAYOFF_RECENT", null]
        },
        "funding_status": {
          "type": ["string", "null"],
          "description": "e.g., 'Series B ($35M in 2025)', 'Bootstrapped / Profitable', 'Public'"
        },
        "recent_adverse_news": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Documented layoffs, executive churn, litigation"
        }
      }
    },
    "extension_intelligence": {
      "type": ["object", "null"],
      "description": "Best-effort fields. Nullable to prevent false-negative stalls.",
      "properties": {
        "hiring_manager": {
          "type": ["object", "null"],
          "properties": {
            "name": { "type": "string" },
            "title": { "type": "string" },
            "linkedin_url": { "type": "string", "format": "uri" },
            "public_commentary_summary": { "type": ["string", "null"] }
          }
        },
        "unlisted_tech_stack": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Inferred from GitHub org, eng blog, or adjacent tech postings"
        },
        "team_turnover_signals": {
          "type": ["string", "null"],
          "description": "Backfill urgency vs structural instability signals"
        }
      }
    },
    "raw_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "retrieved_at", "claim_supported"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "claim_supported": { "type": "string" }
        }
      }
    }
  }
}
