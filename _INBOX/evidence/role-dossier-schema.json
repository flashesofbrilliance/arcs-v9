{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://arcs.care/schemas/role-dossier-schema-v1.json",
  "title": "ARCS Role Dossier Schema v1",
  "description": "Sensor (Perplexity) output contract for external opportunity reconnaissance. Feeds the honesty-graded resume-tailor Falsifier and the Loki/BAR adversarial gauntlet.",
  "type": "object",
  "required": [
    "dossier_id",
    "generated_at",
    "core",
    "verdict",
    "evidence"
  ],
  "properties": {
    "dossier_id": {
      "type": "string",
      "description": "Stable id, e.g. role-<company-slug>-<yyyymmdd>-<hash>"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "const": "perplexity-scout"
    },
    "core": {
      "type": "object",
      "description": "Stable, always-answerable fields. All required — if unknown, use null with a claim entry explaining why, never omit the key.",
      "required": [
        "company",
        "role_title",
        "jd_text",
        "jd_url",
        "posting_first_seen",
        "posting_last_seen",
        "cross_listed"
      ],
      "properties": {
        "company": {
          "type": "string"
        },
        "role_title": {
          "type": "string"
        },
        "jd_text": {
          "type": "string"
        },
        "jd_url": {
          "type": "string",
          "format": "uri"
        },
        "posting_first_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "posting_last_seen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "cross_listed": {
          "type": "object",
          "properties": {
            "on_company_careers_page": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "aggregator_only": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "extension": {
      "type": "object",
      "description": "Best-effort fields. Every field nullable by design — absence means 'not found', not 'false'. Do not force a value to avoid a null; that reintroduces the false-negative trap.",
      "properties": {
        "named_hiring_manager": {
          "type": [
            "string",
            "null"
          ]
        },
        "hiring_manager_public_commentary": {
          "type": [
            "string",
            "null"
          ]
        },
        "salary_band_disclosed": {
          "type": [
            "string",
            "null"
          ]
        },
        "salary_realism_flag": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "consistent",
            "mismatch",
            "unknown",
            null
          ]
        },
        "recent_team_departures": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "funding_or_layoff_signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "unlisted_tech_stack": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "repost_pattern": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. 'reposted 3x since 2026-07-01 under varying titles'"
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "label",
        "human_premortem_required"
      ],
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "ATTAINABLE",
            "TRAP",
            "UNDECIDABLE"
          ],
          "description": "Enum, never a numeric score. Loki/BAR must be able to re-derive this label independently from evidence[]."
        },
        "human_premortem_required": {
          "type": "boolean",
          "description": "MUST be true whenever label == 'UNDECIDABLE'. May also be true for TRAP if stakes warrant. HITL sovereignty invariant."
        },
        "rationale": {
          "type": "string",
          "description": "One paragraph, plain language, citing evidence[] ids."
        }
      }
    },
    "evidence": {
      "type": "array",
      "description": "Raw claims backing core, extension, and verdict. Every non-null field above must trace to at least one entry here.",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "field_ref",
          "value",
          "retrieved_at",
          "source_urls"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "field_ref": {
            "type": "string",
            "description": "Dotted path, e.g. 'extension.named_hiring_manager'"
          },
          "value": {},
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "minItems": 1
          },
          "confidence": {
            "type": "string",
            "enum": [
              "direct",
              "inferred",
              "stale"
            ]
          }
        }
      }
    }
  }
}
