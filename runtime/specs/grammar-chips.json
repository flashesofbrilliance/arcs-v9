{
  "version": "0.1.0",
  "about": "One visual grammar for claim chips (README to video, receipts, briefs). Source of truth: scripts/grammar_chips_emit.py writes src/ui/grammarChipTokens.ts and the CSS block in src/ui-kit/grammar-chips/chips.html from this file. Values come from DESIGN.md (dark: obsidian world; light: Light paper world, every signal at least 4.6:1 on #e9eef4). Dark mode reads the kit tokens (src/ui-kit/recoil-report/_tokens.css, inlined verbatim into the HTML) by name; the hex values here mirror them for JSX.",
  "tones": {
    "say": {
      "glyph": "▲",
      "tag": "SAY",
      "meaning": "the claim",
      "mui": "info",
      "dark": "#00F0FF",
      "light": "#00748e",
      "kitVar": "--cyan"
    },
    "show": {
      "glyph": "●",
      "tag": "SHOW",
      "meaning": "the evidence, measured",
      "mui": "success",
      "dark": "#00FF9D",
      "light": "#0b7a4b",
      "kitVar": "--green"
    },
    "limit": {
      "glyph": "◆",
      "tag": "LIMIT",
      "meaning": "the caveat that travels with it",
      "mui": "warning",
      "dark": "#FFD700",
      "light": "#8a6200",
      "kitVar": "--gold"
    },
    "fail": {
      "glyph": "✕",
      "tag": "FAIL",
      "meaning": "a check that did not pass",
      "mui": "error",
      "dark": "#FF4D6D",
      "light": "#b8233e",
      "kitVar": "--red"
    },
    "shift": {
      "glyph": "◇",
      "tag": "SHIFT",
      "meaning": "a changed value (DELTA)",
      "mui": "secondary",
      "dark": "#A78BFA",
      "light": "#6d4bd1",
      "kitVar": "--violet"
    },
    "neutral": {
      "glyph": "·",
      "tag": "NOTE",
      "meaning": "context, no verdict",
      "mui": "neutral",
      "dark": "#94a3b8",
      "light": "#4b5563",
      "kitVar": "--text-secondary"
    }
  },
  "modes": {
    "dark": {
      "bg": "#020408",
      "panel": "#0d1117",
      "elevated": "#111827",
      "border": "#1e293b",
      "text": "#e2e8f0",
      "textSecondary": "#94a3b8",
      "tint": "7%",
      "edge": "33%",
      "focus": "#00F0FF",
      "kitVars": {
        "bg": "--bg",
        "panel": "--surface",
        "elevated": "--elevated",
        "border": "--border",
        "text": "--text",
        "textSecondary": "--text-secondary",
        "focus": "--cyan"
      }
    },
    "light": {
      "bg": "#ffffff",
      "panel": "#f4f7fa",
      "elevated": "#e9eef4",
      "border": "#c9d3de",
      "text": "#0f172a",
      "textSecondary": "#4b5563",
      "tint": "8%",
      "edge": "45%",
      "focus": "#00748e"
    }
  },
  "fidelity": {
    "sharp": {
      "y": "GREEN, LOCKED",
      "weight": 500,
      "tracking": "0",
      "texture": "none"
    },
    "degraded": {
      "y": "YELLOW, FORK",
      "weight": 400,
      "tracking": "0.01em",
      "texture": "none"
    },
    "grain": {
      "y": "SCRATCH, DELTA, DRIFT, RED",
      "weight": 300,
      "tracking": "0.02em",
      "texture": "speckle"
    },
    "moire": {
      "y": "PARADOX",
      "weight": 300,
      "tracking": "0.03em",
      "texture": "interference"
    }
  },
  "shape": {
    "radius": "3px",
    "padX": "10px",
    "padY": "6px",
    "gap": "8px",
    "tagSize": "0.6875rem",
    "bodySize": "0.925rem"
  },
  "fonts": {
    "mono": "'JetBrains Mono', 'IBM Plex Mono', ui-monospace, monospace",
    "sans": "'Inter', system-ui, -apple-system, sans-serif"
  },
  "rules": [
    "Color is never the only cue: every tone carries its glyph and its tag.",
    "Fidelity sets the body text weight and tracking (the WORLD.md render scale); the mono tag holds at 700. Text stays at full opacity at every fidelity; fog shows through weight, tracking and texture (WORLD.md, 2026-10-11).",
    "A claim strip that holds a SAY chip and no LIMIT chip, where the source has a caveat, renders the FAIL state (rule R5).",
    "Signal color tints border, tag and glyph only; the body text stays in the mode's text color."
  ]
}
