 "classes": {
  "bomb_proofing": {
   "lenses": [
    "BAR",
    "Funhouse Q2 Concave",
    "KKL Kairos Lock"
   ],
   "verdict": "holds",
   "weakest_joint": "BAR flags RUIN_RISK only when irreversibility is set above 0.7 (Put read as a build commitment); the call itself is a reversible public post.",
   "cheapest_fix": "Say on the page that the stake is the post, and time-box any pre-rule build (e.g. 2 weeks)."
  },
  "fire_proofing": {
   "lenses": [
    "COURT (evidence test)",
    "LAB L-lens (Loki, custom challenge)"
   ],
   "verdict": "leaks",
   "weakest_joint": "Resolution rule is unregistered: median P is 0.24 network-only, 0.30 as written, 0.62 loose; the reading moves P more than any driver.",
   "cheapest_fix": "One pre-registered resolution line: who counts, what counts as an intent record, announce vs effective, and a named resolver."
  },
  "water_proofing": {
   "lenses": [
    "LAB A/B-lens (advisors, Bayesian)",
    "Monte Carlo sensitivity",
    "KKL timing window"
   ],
   "verdict": "leaks",
   "weakest_joint": "base_network (judgment 0.04-0.15) carries most variance (tornado swing 0.25, Spearman 0.82) and the call has no decay schedule as the 7.6-month window closes.",
   "cheapest_fix": "Pre-register a mark-to-market at each Visa/Mastercard rules release before 2027-06-30."
  },
  "air_gapping": {
   "lenses": [
    "Funhouse Q3 Parabolic",
    "COURT identity test"
   ],
   "verdict": "leaks",
   "weakest_joint": "Author sells the remedy and grades his own call; the Put's premise overstates what ARCS writes (append-only human receipt, no signature, mandate or transaction binding).",
   "cheapest_fix": "Disclose the interest in one line, name an outside resolver, reword the Put to what the receipt actually is."
  }
