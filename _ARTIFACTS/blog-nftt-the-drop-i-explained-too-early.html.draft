<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>The Drop I Explained Too Early · NFTT</title>
<meta name="description" content="USDC supply fell about $5.7B to $6.6B in two weeks of January 2026, and my published explanation did not survive the first test. The tests, the scores, and the one test I cannot run.">
<meta name="robots" content="index">
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root{
    --bg:#020408; --surface:#0b1017; --surface-2:#111823; --border:#1e293b; --border-2:#2a3a4d;
    --text:#e7ecf3; --muted:#9aa8bc; --dim:#748699;
    --cyan:#00F0FF; --cyan-dim:#3aa8b4; --red:#FF4D6D; --gold:#FFD700;
    --redact:#26303d;
    --serif:"Newsreader","Newsreader Fallback",Georgia,"Times New Roman",serif;
    --mono:"IBM Plex Mono","IBM Plex Mono Fallback",ui-monospace,SFMono-Regular,Menlo,monospace;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:var(--serif); font-size:19px; line-height:1.75; font-weight:400;
    -webkit-font-smoothing:antialiased; letter-spacing:.005em;
  }
  .wrap{max-width:40rem; margin:0 auto; padding:0 22px}

  /* classification rails */
  .cls{font-family:var(--mono); font-size:11px; letter-spacing:.2em; text-transform:uppercase;
    color:var(--dim); display:flex; gap:12px; align-items:center; flex-wrap:wrap;
    border-bottom:1px solid var(--border); padding:12px 0; margin-bottom:44px}
  .cls b{color:var(--red); font-weight:600}
  .cls .sp{margin-left:auto}
  .dot{width:7px;height:7px;border-radius:50%;background:var(--red);display:inline-block}

  header.hero{padding-block:20px 10px}
  .cover{display:block; width:100%; height:auto; border-radius:12px;
    border:1px solid var(--border); margin:6px 0 4px; background:var(--surface-2)}
  .eyebrow{font-family:var(--mono); font-size:12px; letter-spacing:.22em; text-transform:uppercase;
    color:var(--cyan); margin:0 0 20px}
  h1{font-family:var(--serif); font-weight:600; font-size:clamp(2.6rem,8vw,4.1rem); line-height:1.02;
    letter-spacing:-.015em; margin:0 0 18px; text-wrap:balance}
  h1 em{font-style:italic; font-weight:500; color:var(--cyan)}
  .standfirst{font-size:1.24rem; line-height:1.6; color:var(--muted); font-style:italic;
    margin:0 0 8px; max-width:34rem}
  .byline{font-family:var(--mono); font-size:11.5px; letter-spacing:.13em; text-transform:uppercase;
    color:var(--dim); margin:26px 0 0; padding-top:18px; border-top:1px solid var(--border)}

  section{margin:52px 0}
  .num{font-family:var(--mono); font-size:12px; letter-spacing:.24em; color:var(--cyan-dim);
    display:block; margin:0 0 14px}
  h2{font-family:var(--serif); font-weight:600; font-size:1.7rem; line-height:1.15; letter-spacing:-.01em;
    margin:0 0 20px; text-wrap:balance}
  p{margin:0 0 22px}
  .lead::first-letter{
    font-weight:600; font-size:3.5em; line-height:.82; float:left;
    padding:.02em .09em 0 0; color:var(--cyan);
  }
  em{font-style:italic}
  .vox{font-style:italic; color:var(--text)}

  /* redaction */
  .rd{background:var(--redact); color:transparent; border-radius:2px; padding:.02em .2em;
    user-select:none; box-shadow:inset 0 0 0 1px var(--border-2); -webkit-user-select:none}
  .rd::selection{background:var(--redact)}
  .rdrow{display:inline-flex; gap:7px; flex-wrap:wrap; vertical-align:-2px; margin:0 .1em}
  .rdrow span{background:var(--redact); border-radius:2px; height:1.05em; display:inline-block;
    box-shadow:inset 0 0 0 1px var(--border-2)}

  /* threat vector card */
  .vector{border:1px solid color-mix(in srgb,var(--red) 32%,var(--border-2));
    background:linear-gradient(180deg,rgba(255,77,109,.05),var(--bg)); border-radius:12px;
    padding:22px 24px; margin:44px 0; font-family:var(--mono)}
  .vector h3{font-family:var(--mono); font-size:12.5px; letter-spacing:.18em; text-transform:uppercase;
    color:var(--red); font-weight:600; margin:0 0 4px; display:flex; align-items:center; gap:9px}
  .vector .sub{font-size:10.5px; letter-spacing:.16em; text-transform:uppercase; color:var(--dim);
    margin:0 0 18px}
  .vector dl{display:grid; grid-template-columns:auto 1fr; gap:9px 16px; margin:0; font-size:13px; line-height:1.5}
  .vector dt{color:var(--cyan-dim); letter-spacing:.06em; text-transform:uppercase; font-size:10.5px; padding-top:2px; white-space:nowrap}
  .vector dd{margin:0; color:var(--text)}
  .vector dd .df{color:var(--muted)}
  .vector .dispo{margin-top:16px; padding-top:14px; border-top:1px solid var(--border);
    font-size:12px; color:var(--muted); letter-spacing:.04em}
  .vector .dispo b{color:var(--gold); font-weight:600}
  @media(max-width:520px){.vector dl{grid-template-columns:1fr; gap:3px 0} .vector dt{padding-top:12px}}

  blockquote{margin:34px 0; padding:0 0 0 20px; border-left:2px solid var(--cyan);
    font-size:1.28rem; line-height:1.5; font-style:italic; color:var(--text)}

  /* operational instrument panels, interleaved through the prose */
  .panel{border:1px solid color-mix(in srgb,var(--cyan) 20%,var(--border)); background:var(--surface-2);
    border-radius:10px; padding:20px 22px; margin:40px 0; font-family:var(--mono)}
  .panel h4{font-family:var(--mono); font-size:11.5px; letter-spacing:.16em; text-transform:uppercase;
    color:var(--cyan); margin:0 0 15px; font-weight:600; display:flex; align-items:center; gap:8px; flex-wrap:wrap}
  .panel .step{display:grid; grid-template-columns:auto 1fr; gap:9px 15px; font-size:12.5px; line-height:1.5}
  .panel .step b{color:var(--text); font-weight:500}
  .panel .step b.df{color:var(--muted)}
  .panel .step em{color:var(--cyan); font-style:italic}
  .panel .k{color:var(--cyan-dim); text-transform:uppercase; letter-spacing:.05em; font-size:11.5px;
    white-space:nowrap; padding-top:2px}
  .panel code{color:var(--gold); font-size:.9em}
  /* ledger rows: single column, label as a heading with a divider (2026-09-29) */
  .panel .step{grid-template-columns:1fr; gap:4px 0}
  .panel .step .k{white-space:normal; border-top:1px solid var(--border); padding-top:14px; margin-top:10px}
  .panel .step .k:first-child{border-top:0; padding-top:0; margin-top:0}
  .panel > p{font-family:var(--mono); font-size:12px; color:var(--muted); line-height:1.6; margin:14px 0 0}
  .panel .sev{font-size:9.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--red);
    border:1px solid var(--red); border-radius:4px; padding:1px 6px; font-weight:600}
  @media(max-width:520px){.panel .step{grid-template-columns:1fr; gap:2px 0} .panel .k{padding-top:12px}}

  footer{margin:64px 0 80px; padding-top:22px; border-top:1px solid var(--border);
    font-family:var(--mono); font-size:11.5px; letter-spacing:.08em; color:var(--dim); line-height:1.9}
  footer b{color:var(--muted); font-weight:500}

  .more{margin:56px 0 0; text-align:center}
  .more a{font-family:var(--mono); font-size:13px; letter-spacing:.07em; color:var(--cyan);
    text-decoration:none; border:1px solid var(--border-2); border-radius:9px; padding:15px 24px;
    display:inline-block; transition:border-color .15s, background .15s}
  .more a:hover{border-color:var(--cyan); background:rgba(0,240,255,.06)}
  .more .lbl{color:var(--dim); text-transform:uppercase; letter-spacing:.16em; font-size:10px;
    display:block; margin-bottom:6px}

  /* the one loop: the spine this whole account runs on */
  .loopspine{font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--dim); margin:22px 0 0; padding-top:16px; border-top:1px solid var(--border);
    display:flex; align-items:center; gap:9px; flex-wrap:wrap}
  .loopspine b{color:var(--cyan); font-weight:600; letter-spacing:.14em}
  .loopspine i{color:var(--border-2); font-style:normal}

  ::selection{background:rgba(0,240,255,.22)}
  :focus-visible{outline:2px solid var(--cyan); outline-offset:3px}
  @media (prefers-reduced-motion:reduce){*{scroll-behavior:auto}}

  /* mobile-lock */
  html,body{overflow-x:clip; overscroll-behavior-y:none}
  .mono{overflow-wrap:anywhere}
  footer{margin-bottom:44px}
  /* lede spans the full lane, edge to edge with the heading (design-full-width-lede-matches-heading) */
  .standfirst{max-width:none}
</style>
