{
  "version": "0.1.0",
  "description": "Default Observatory event ruleset — generic conventional-commits. Edit this to define your own custom events: each rule maps a GitHub signal (commit/PR/release/workflow) to an Observatory event with an altitude (L5 executive -> L1 surgical), a type, and a confidence. First matching rule wins.",
  "event_rules": [
    {
      "id": "genesis",
      "when": { "kind_in": ["release"], "subject_matches": "(?i)v?0\\.0|initial|genesis|first" },
      "set": { "type": "genesis", "alt": "L3", "conf": 84, "peak": true }
    },
    {
      "id": "security",
      "when": { "subject_matches": "(?i)\\b(security|rls|secret|credential|deny-all|cve|vuln|sanitize|auth)\\b" },
      "set": { "type": "security", "alt": "L4", "conf": 90, "peak": true }
    },
    {
      "id": "governance",
      "when": { "subject_matches": "(?i)\\b(adr|rfc|decision|govern|strategy|canon|spec)\\b" },
      "set": { "type": "milestone", "alt": "L5", "conf": 90, "peak": true }
    },
    {
      "id": "release",
      "when": { "kind_in": ["release"] },
      "set": { "type": "milestone", "alt": "L3", "conf": 92, "peak": true }
    },
    {
      "id": "deploy",
      "when": { "subject_matches": "(?i)\\b(deploy|release|ship|vercel|publish|rollout|ga|ready)\\b" },
      "set": { "type": "milestone", "alt": "L3", "conf": 90, "peak": true }
    },
    {
      "id": "feat-ui",
      "when": { "prefix_in": ["feat"], "subject_matches": "(?i)\\b(ui|ux|design|component|page|view|button|card|style|css)\\b" },
      "set": { "type": "feat", "alt": "L2", "conf": 88 }
    },
    {
      "id": "feat",
      "when": { "prefix_in": ["feat"] },
      "set": { "type": "feat", "alt": "L3", "conf": 88 }
    },
    {
      "id": "perf",
      "when": { "prefix_in": ["perf"] },
      "set": { "type": "feat", "alt": "L2", "conf": 86 }
    },
    {
      "id": "fix-critical",
      "when": { "prefix_in": ["fix"], "subject_matches": "(?i)\\b(critical|hotfix|unblock|crash|data ?loss|prod|outage)\\b" },
      "set": { "type": "fix", "alt": "L3", "conf": 90, "peak": true }
    },
    {
      "id": "fix",
      "when": { "prefix_in": ["fix"] },
      "set": { "type": "fix", "alt": "L1", "conf": 86 }
    }
  ],
  "risk_rules": [
    {
      "id": "secrets",
      "when": { "subject_matches": "(?i)\\b(secret|filter-repo|purge|history-scrub|credential)\\b" },
      "set": { "sev": "RUIN", "status": "AVERTED", "how": "history rewrite + secret rotation", "risk": "Credentials committed to git history", "note": "API keys reached git history and were purged before exploitation. Ruin-class — a single exposure is unrecoverable." }
    },
    {
      "id": "rls",
      "when": { "subject_matches": "(?i)\\brls\\b|deny-all" },
      "set": { "sev": "HIGH", "status": "AVERTED", "how": "RLS deny-all on all tables", "risk": "Unauthenticated data access (no RLS)", "note": "Tables were briefly reachable without auth; closed by deny-all row-level security." }
    },
    {
      "id": "auth-gap",
      "when": { "subject_matches": "(?i)soft-guard|unauthenticated|auth gate" },
      "set": { "sev": "HIGH", "status": "MITIGATED", "how": "app-layer session guard", "risk": "Unauthenticated API access", "note": "API routes were reachable without a session; guarded at the app layer (prod enforces, dev passes through)." }
    },
    {
      "id": "xuser",
      "when": { "subject_matches": "(?i)anonymous compass|receipt.?claim|cross.?user" },
      "set": { "sev": "HIGH", "status": "MITIGATED", "how": "scoped per-session receipt-claim", "risk": "Cross-user data leakage", "note": "Anonymous compass receipts scoped per session to prevent cross-user reads." }
    },
    {
      "id": "deploy-blocker",
      "when": { "subject_matches": "(?i)prismapg|prisma.*adapter|p1012|unblock.*deploy|deploy.*block" },
      "set": { "sev": "MED", "status": "AVERTED", "how": "adapter / config fix", "risk": "Deploy blocked — Prisma 7 adapter", "note": "Prisma 7 engine/schema mismatch blocked the deploy; resolved by the PrismaPg adapter pattern." }
    },
    {
      "id": "revert",
      "when": { "subject_matches": "(?i)^revert|\\brollback\\b|\\bback ?out\\b" },
      "set": { "sev": "HIGH", "status": "MITIGATED", "how": "reverted", "risk": null }
    },
    {
      "id": "incident",
      "when": { "subject_matches": "(?i)\\b(incident|outage|breach|data ?loss|leak|exposed)\\b" },
      "set": { "sev": "RUIN", "status": "MITIGATED", "how": "see commit" }
    },
    {
      "id": "ci-failure",
      "when": { "kind_in": ["workflow"], "status_in": ["failure"] },
      "set": { "sev": "MED", "status": "OPEN", "how": "CI red" }
    }
  ],
  "drop": {
    "subject_matches": "(?i)^(chore|docs|test|style|build|ci)(\\(|:)|^[a-z]+\\(resume\\)|merge branch|merge pull request|bump|handoff|snapshot|pickup|\\bwip\\b|typo|lint|format|gitignore"
  },
  "default": { "type": "feat", "alt": "L1", "conf": 80, "keep": false }
}
