      echo "✖ commit blocked: template code would render as visible text (see above)." >&2
      echo "  render it to static markup, or move it into a <script> that builds the DOM." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# card-gutter gate (headless sibling of the wrap lint): a NEW artifact whose text
# block inside a bordered card is >40px narrower than the card's inner width at
# 360/790/1280 (the dead right gutter static lint cannot see). Added-only, like the
# wrap lint. Skips cleanly when node or playwright is unavailable.
if [ -f scripts/card_gutter_check.mjs ] && command -v node >/dev/null 2>&1; then
  cg=$(git diff --cached --name-only --diff-filter=A -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$cg" ]; then
    echo "$cg" | tr '\n' '\0' | xargs -0 node scripts/card_gutter_check.mjs; rc=$?
    if [ "$rc" -eq 1 ]; then
      echo "✖ commit blocked: dead right gutter inside a card in a NEW artifact (see above)." >&2
      exit 1
    fi
  fi
fi

