#!/usr/bin/env bash
# pre-commit — oracle guard: reject a commit that introduces a DUPLICATE ADR number.
#
# Root cause of the 2026 ADR-number collisions: parallel sessions/harnesses (Claude Code,
# Hermes) mint numbers by inference instead of `oracle next adr`. The oracle is a git-backed
# logical clock, but it is advisory — this hook makes bypassing it UN-COMMITTABLE, harness-
# agnostic (git runs it regardless of which agent staged the files).
#
# Install once (propagates to all worktrees — they share the common .git):
#   git config core.hooksPath scripts/git-hooks
#
# Blocks only when a NEWLY-ADDED _DECISIONS/ADR-<n>-*.md reuses a number that already exists
# in HEAD. Pre-existing collisions do NOT block unrelated commits (only new dups are gated).
# Also WARNS (non-blocking) when a new ADR's number exceeds the committed oracle counter
# (_SEEDS/_oracle.json) — the signal that it was minted off-oracle.
set -euo pipefail

added=$(git diff --cached --name-only --diff-filter=A -- '_DECISIONS/ADR-*.md' 2>/dev/null || true)
# NB: do NOT `exit 0` here when $added is empty — later guards (wrap-class) must still run.
if [ -n "$added" ]; then
  # existing ADR numbers already in HEAD (the committed tree)
  existing=$(git ls-tree -r --name-only HEAD -- _DECISIONS 2>/dev/null \
    | grep -oiE 'ADR-[0-9]+' | grep -oE '[0-9]+' | sed 's/^0*//' | sort -u || true)

  oracle_counter=$(git show HEAD:_SEEDS/_oracle.json 2>/dev/null \
    | grep -oE '"adr"[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+$' || echo 0)

  fail=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    n=$(basename "$f" | grep -oiE 'ADR-[0-9]+' | grep -oE '[0-9]+' | sed 's/^0*//')
    [ -z "$n" ] && continue
    if echo "$existing" | grep -qx "$n"; then
      echo "✖ pre-commit(oracle-guard): ADR-$(printf '%03d' "$n") already exists in HEAD — this commit would DUPLICATE it." >&2
      echo "  file: $f" >&2
      echo "  fix:  run 'python3 scripts/oracle.py next adr' for a fresh number, rename the file, commit _SEEDS/_oracle.json." >&2
      fail=1
    elif [ "${oracle_counter:-0}" -gt 0 ] && [ "$n" -gt "$oracle_counter" ]; then
      echo "⚠ pre-commit(oracle-guard): ADR-$(printf '%03d' "$n") is above the committed oracle counter ($oracle_counter) — looks minted off-oracle. Not blocking, but verify with 'python3 scripts/oracle.py audit adr'." >&2
    fi
  done <<< "$added"

  [ "$fail" -eq 1 ] && { echo "✖ commit blocked: duplicate ADR number. (canon-collision-escalate: allocate via the oracle, don't reuse.)" >&2; exit 1; }
fi

# ---------------------------------------------------------------------------
# wrap-class guard: reject NEWLY-ADDED public/*.html that carry the
# intermediate-width wrap-regression class (em-dash in rendered copy, or a
# per-role `max-width:NNch` on text). See scripts/artifact_wrap_lint.py and
# memory intermediate-width-wrap-regression-class.
#
# ADDED-only, by design — mirrors the oracle guard above: a brand-new artifact
# (the recurrence population: each self-contained page re-authors CSS fresh)
# must be born clean, but the repo's large pre-existing em-dash debt does NOT
# block an unrelated edit to a legacy page. Regressions inside modified files
# are left to the manual sweep / a future net-new-diff check.
# Skips cleanly when the linter or python3 is absent (older worktrees stay committable).
if [ -f scripts/artifact_wrap_lint.py ] && command -v python3 >/dev/null 2>&1; then
  html=$(git diff --cached --name-only --diff-filter=A -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$html" ]; then
    if ! echo "$html" | tr '\n' '\0' | xargs -0 python3 scripts/artifact_wrap_lint.py; then
      echo "✖ commit blocked: wrap-class violation in a NEW public/*.html (see above)." >&2
      echo "  fix the em-dash / ch-cap findings, re-sweep 375/790/desktop, then re-stage." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# NFTT head-meta gate: every blog-nftt-*.html post must carry the title '· NFTT'
# suffix + a description meta + a robots meta (presence, not value -- noindex
# fragments stay noindex). nftt-gates.sh enforces this ONE FILE AT A TIME, so
# legacy posts predating the gate carried the gap for months (Frustration Gate,
# banked 2026-09-26). ADDED + MODIFIED, by design: a new post OR an edit to an
# existing one must conform. The index listing page is exempt (see the script).
# Skips cleanly when the gate or python3 is absent. See scripts/nftt_meta_gate.py.
if [ -f scripts/nftt_meta_gate.py ] && command -v python3 >/dev/null 2>&1; then
  nftt=$(git diff --cached --name-only --diff-filter=AM -- 'public/blog-nftt-*.html' 2>/dev/null || true)
  if [ -n "$nftt" ]; then
    if ! echo "$nftt" | tr '\n' '\0' | xargs -0 python3 scripts/nftt_meta_gate.py; then
      echo "✖ commit blocked: NFTT head-meta gap in a staged post (see above)." >&2
      echo "  add the '· NFTT' title suffix / description meta / robots meta, then re-stage." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# Generated-page drift gate (2026-10-03): good.arcs.care (+ its connector pages) and the NFTT
# index are RENDERED pages. Both once drifted far enough that a rebuild would have reverted
# live work (fixed e9085fd7). CI runs both --check steps, but CI can be down (Actions billing,
# 2026-09-30..10-03) and then nothing stopped a hand edit to the output. Fires only when a
# rendered page or one of its inputs is staged. Fix: edit the generator/inputs, re-render,
# re-stage. Never hand-edit the output.
gen_good=$(git diff --cached --name-only -- public/good.html public/rosetta-shell.html public/germinate.html public/arcs-field-scan.html scripts/connector_render.py _SEEDS/distribution.jsonl _SEEDS/connectors.json 2>/dev/null || true)
