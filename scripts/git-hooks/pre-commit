#!/usr/bin/env bash
# pre-commit — oracle guard: reject a commit that introduces a DUPLICATE ADR number.
#
# Root cause of the 2026 ADR-number collisions: parallel sessions/harnesses (Claude Code,
# Hermes) mint numbers by inference instead of `oracle next adr`. The oracle is a git-backed
# logical clock, but it is advisory — this hook makes bypassing it UN-COMMITTABLE, harness-
# agnostic (git runs it regardless of which agent staged the files).
#
# Install once (propagates to all worktrees — they share the common .git):
#   git config core.hooksPath scripts/git-hooks
#
# Blocks only when a NEWLY-ADDED _DECISIONS/ADR-<n>-*.md reuses a number that already exists
# in HEAD. Pre-existing collisions do NOT block unrelated commits (only new dups are gated).
# Also WARNS (non-blocking) when a new ADR's number exceeds the committed oracle counter
# (_SEEDS/_oracle.json) — the signal that it was minted off-oracle.
set -euo pipefail

added=$(git diff --cached --name-only --diff-filter=A -- '_DECISIONS/ADR-*.md' 2>/dev/null || true)
[ -z "$added" ] && exit 0

# existing ADR numbers already in HEAD (the committed tree)
existing=$(git ls-tree -r --name-only HEAD -- _DECISIONS 2>/dev/null \
  | grep -oiE 'ADR-[0-9]+' | grep -oE '[0-9]+' | sed 's/^0*//' | sort -u || true)

oracle_counter=$(git show HEAD:_SEEDS/_oracle.json 2>/dev/null \
  | grep -oE '"adr"[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+$' || echo 0)

fail=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  n=$(basename "$f" | grep -oiE 'ADR-[0-9]+' | grep -oE '[0-9]+' | sed 's/^0*//')
  [ -z "$n" ] && continue
  if echo "$existing" | grep -qx "$n"; then
    echo "✖ pre-commit(oracle-guard): ADR-$(printf '%03d' "$n") already exists in HEAD — this commit would DUPLICATE it." >&2
    echo "  file: $f" >&2
    echo "  fix:  run 'python3 scripts/oracle.py next adr' for a fresh number, rename the file, commit _SEEDS/_oracle.json." >&2
    fail=1
  elif [ "${oracle_counter:-0}" -gt 0 ] && [ "$n" -gt "$oracle_counter" ]; then
    echo "⚠ pre-commit(oracle-guard): ADR-$(printf '%03d' "$n") is above the committed oracle counter ($oracle_counter) — looks minted off-oracle. Not blocking, but verify with 'python3 scripts/oracle.py audit adr'." >&2
  fi
done <<< "$added"

[ "$fail" -eq 1 ] && { echo "✖ commit blocked: duplicate ADR number. (canon-collision-escalate: allocate via the oracle, don't reuse.)" >&2; exit 1; }
exit 0
