# (`${...}`, a dangling `).join(`) as visible text. Found in the Claude Design Instrument
# Panel card, where JS template literals sat in plain HTML and rendered as code. The repo
# baseline was 0 leaks across every tracked .html, so ADDED and MODIFIED pages both block.
# Kintsugi seam: _PATTERNS/kintsugi-visual-grammar-seams.md 2026-10-08. Skips without python3.
if [ -f scripts/template_leak_lint.py ] && command -v python3 >/dev/null 2>&1; then
  tl=$(git diff --cached --name-only --diff-filter=AM -- '*.html' 2>/dev/null || true)
  if [ -n "$tl" ]; then
