# Scratch-git leak gate (2026-11-12, gotcha 15): a staged script whose --self-test builds a scratch git repo
# is run under a worktree hook's env against a throwaway host repo; any write to the host's config or refs
# blocks. The tripwire at the top catches what reaches the real config; this names the script before it does.
if [ -f scripts/scratch_git_leak_gate.py ] && command -v python3 >/dev/null 2>&1; then
  sg_staged=$(git diff --cached --name-only --diff-filter=AM -- 'scripts/*.py' 'scripts/*.sh' 2>/dev/null || true)
  if [ -n "$sg_staged" ]; then
    sg_list=$(python3 scripts/scratch_git_leak_gate.py --list)
    sg_run=$(printf '%s\n' $sg_staged | grep -Fxf <(printf '%s\n' $sg_list) || true)
    if printf '%s\n' $sg_staged | grep -qx scripts/scratch_git_leak_gate.py; then
      python3 scripts/scratch_git_leak_gate.py --self-test >/dev/null 2>&1 || { python3 scripts/scratch_git_leak_gate.py --self-test >&2 || true; echo "✖ commit blocked: scratch_git_leak_gate.py --self-test failed." >&2; exit 1; }
    fi
    if [ -n "$sg_run" ] && ! python3 scripts/scratch_git_leak_gate.py $sg_run; then
      echo "✖ commit blocked: a staged self-test writes to the repo that runs it (see above)." >&2
      exit 1
    fi
  fi
fi
