  if ! python3 scripts/connector_render.py --check >/dev/null 2>&1; then
    echo "✖ commit blocked: a good.arcs.care page differs from its renderer." >&2
    echo "  run 'python3 scripts/connector_render.py --check' to see which; edit the renderer or _SEEDS inputs, re-render, re-stage." >&2
    exit 1
  fi
fi
gen_nftt=$(git diff --cached --name-only -- public/blog-nftt-index.html scripts/nftt_index_build.mjs scripts/nftt_index_layout.json runtime/specs/nftt-published.json 2>/dev/null || true)
if [ -n "$gen_nftt" ] && [ -f scripts/nftt_index_build.mjs ] && command -v node >/dev/null 2>&1; then
  if ! node scripts/nftt_index_build.mjs --check >/dev/null 2>&1; then
    echo "✖ commit blocked: public/blog-nftt-index.html differs from scripts/nftt_index_build.mjs." >&2
    echo "  add the post to the builder (or its layout json), run 'node scripts/nftt_index_build.mjs', re-stage." >&2
    exit 1
  fi
fi

