  if [ -n "$ser" ] && ! python3 scripts/nftt_series.py --check; then
    echo "✖ commit blocked: a serialized NFTT part is missing or stale (see above)." >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
