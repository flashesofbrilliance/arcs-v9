#!/usr/bin/env bash
# pre-commit — oracle guard: reject a commit that introduces a DUPLICATE ADR number.
#
# Root cause of the 2026 ADR-number collisions: parallel sessions/harnesses (Claude Code,
# Hermes) mint numbers by inference instead of `oracle next adr`. The oracle is a git-backed
# logical clock, but it is advisory — this hook makes bypassing it UN-COMMITTABLE, harness-
# agnostic (git runs it regardless of which agent staged the files).
#
# Install once (propagates to all worktrees — they share the common .git):
#   git config core.hooksPath scripts/git-hooks
#
# Blocks only when a NEWLY-ADDED _DECISIONS/ADR-<n>-*.md reuses a number that already exists
# in HEAD. Pre-existing collisions do NOT block unrelated commits (only new dups are gated).
# Also WARNS (non-blocking) when a new ADR's number exceeds the committed oracle counter
# (_SEEDS/_oracle.json) — the signal that it was minted off-oracle.
set -euo pipefail

added=$(git diff --cached --name-only --diff-filter=A -- '_DECISIONS/ADR-*.md' 2>/dev/null || true)
# NB: do NOT `exit 0` here when $added is empty — later guards (wrap-class) must still run.
if [ -n "$added" ]; then
  # existing ADR numbers already in HEAD (the committed tree)
  existing=$(git ls-tree -r --name-only HEAD -- _DECISIONS 2>/dev/null \
    | grep -oiE 'ADR-[0-9]+' | grep -oE '[0-9]+' | sed 's/^0*//' | sort -u || true)

  oracle_counter=$(git show HEAD:_SEEDS/_oracle.json 2>/dev/null \
    | grep -oE '"adr"[[:space:]]*:[[:space:]]*[0-9]+' | grep -oE '[0-9]+$' || echo 0)

  fail=0
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    n=$(basename "$f" | grep -oiE 'ADR-[0-9]+' | grep -oE '[0-9]+' | sed 's/^0*//')
    [ -z "$n" ] && continue
    if echo "$existing" | grep -qx "$n"; then
      echo "✖ pre-commit(oracle-guard): ADR-$(printf '%03d' "$n") already exists in HEAD — this commit would DUPLICATE it." >&2
      echo "  file: $f" >&2
      echo "  fix:  run 'python3 scripts/oracle.py next adr' for a fresh number, rename the file, commit _SEEDS/_oracle.json." >&2
      fail=1
    elif [ "${oracle_counter:-0}" -gt 0 ] && [ "$n" -gt "$oracle_counter" ]; then
      echo "⚠ pre-commit(oracle-guard): ADR-$(printf '%03d' "$n") is above the committed oracle counter ($oracle_counter) — looks minted off-oracle. Not blocking, but verify with 'python3 scripts/oracle.py audit adr'." >&2
    fi
  done <<< "$added"

  [ "$fail" -eq 1 ] && { echo "✖ commit blocked: duplicate ADR number. (canon-collision-escalate: allocate via the oracle, don't reuse.)" >&2; exit 1; }
fi

# ---------------------------------------------------------------------------
# wrap-class guard: reject NEWLY-ADDED public/*.html that carry the
# intermediate-width wrap-regression class (em-dash in rendered copy, or a
# per-role `max-width:NNch` on text). See scripts/artifact_wrap_lint.py and
# memory intermediate-width-wrap-regression-class.
#
# ADDED-only, by design — mirrors the oracle guard above: a brand-new artifact
# (the recurrence population: each self-contained page re-authors CSS fresh)
# must be born clean, but the repo's large pre-existing em-dash debt does NOT
# block an unrelated edit to a legacy page. Regressions inside modified files
# are left to the manual sweep / a future net-new-diff check.
# Skips cleanly when the linter or python3 is absent (older worktrees stay committable).
if [ -f scripts/artifact_wrap_lint.py ] && command -v python3 >/dev/null 2>&1; then
  html=$(git diff --cached --name-only --diff-filter=A -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$html" ]; then
    if ! echo "$html" | tr '\n' '\0' | xargs -0 python3 scripts/artifact_wrap_lint.py; then
      echo "✖ commit blocked: wrap-class violation in a NEW public/*.html (see above)." >&2
      echo "  fix the em-dash / ch-cap findings, re-sweep 375/790/desktop, then re-stage." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# tooltip-link guard: a glossary `.term` tooltip whose click handler preventDefaults
# without a closest('a') guard silently blocks link navigation when a term sits inside
# an <a> (banked 2026-09-23). ADDED + MODIFIED, by design: the bug arrives via an edit
# to an existing tooltip page, not only a new one; the linter SKIPs non-tooltip pages so
# legacy files never false-fail. See scripts/tooltip_link_lint.py.
if [ -f scripts/tooltip_link_lint.py ] && command -v python3 >/dev/null 2>&1; then
  ttl=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$ttl" ]; then
    if ! echo "$ttl" | tr '\n' '\0' | xargs -0 python3 scripts/tooltip_link_lint.py; then
      echo "✖ commit blocked: term-tooltip handler missing the closest('a') link-nav guard (see above)." >&2
      echo "  add: if(t.closest('a'))return;  to the .term click handler, then re-stage." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# div-balance guard: an unclosed <div> (e.g. a `.row` ending in </p> with no </div>)
# silently nests the next sibling inside it; when the parent lays children out in columns,
# the nested block renders as a pinched column instead of its own full-width row -- a visual
# regression the wrap-lint cannot see (nothing overflows). Banked 2026-09-23 (vico.html
# how-I-work section). ADDED + MODIFIED: the bug arrives via an edit to an existing page.
# The check ignores <script>/<style> bodies, so inline deck JS never false-fails.
if [ -f scripts/html_div_balance_lint.py ] && command -v python3 >/dev/null 2>&1; then
  divs=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$divs" ]; then
    if ! echo "$divs" | tr '\n' '\0' | xargs -0 python3 scripts/html_div_balance_lint.py; then
      echo "✖ commit blocked: <div> imbalance in a staged page (see above) — an unclosed div collapses a sibling into a pinched column." >&2
      echo "  find the row that ends in </p> without </div> and close it, then re-stage." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# gutter-consistency guard: in the recoil-report page template, header/footer horizontal
# padding drifting from the body `.pad` gutter (44px vs 40px) indents every header/footer
# element a few px inward of the body -- a left edge that lies about its lane, invisible to
# the wrap-lint. Banked 2026-09-24 after it propagated to 6 sibling pages from one template.
# ADDED + MODIFIED; the linter SKIPs pages with no `.pad` container so other layouts never fail.
if [ -f scripts/gutter_consistency_lint.py ] && command -v python3 >/dev/null 2>&1; then
  gut=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$gut" ]; then
    if ! echo "$gut" | tr '\n' '\0' | xargs -0 python3 scripts/gutter_consistency_lint.py; then
      echo "✖ commit blocked: header/footer gutter differs from body .pad (see above) — align them so the left edge is true." >&2
      echo "  set header{} and footer{} horizontal padding to the same px as .pad, then re-stage." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# informativeness ratchet: when the audit corpus or the gate machinery is staged,
# block on NEW signal degeneracy beyond the committed baseline
# (operators/audit_service/informativeness_baseline.json). Pre-existing SAGE
# degeneracy is frozen; a field that carried information going constant blocks.
# Deterministic, stdlib-only. Skips cleanly if the gate or python3 is absent.
if [ -f operators/audit_service/informativeness_gate.py ] && command -v python3 >/dev/null 2>&1; then
  touched=$(git diff --cached --name-only -- \
    'operators/audit_service/audit_traces.jsonl' \
    'operators/audit_service/informativeness_gate.py' \
    'operators/audit_service/informativeness_sensor.py' \
    'operators/audit_service/informativeness_baseline.json' 2>/dev/null || true)
  if [ -n "$touched" ]; then
    if ! python3 operators/audit_service/informativeness_gate.py; then
      echo "✖ commit blocked: informativeness ratchet — a NEW field went degenerate (see above)." >&2
      echo "  fix the data path, or if intended add it to informativeness_baseline.json with a note." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# integrity gate (ADR-075 GATE organ, Reading Room Phase 0): every ADR / commit sha /
# repo path cited by a staged record (_DECISIONS, _MEMORY, _SPECS, _CANON, _STATE, _SEEDS,
# _PATTERNS, root *.md) must exist on origin/main. See scripts/integrity_gate.py.
# WARN-THEN-BLOCK rollout: warns by default; set INTEGRITY_GATE_BLOCK=1 to make a FAIL
# verdict reject the commit. Skips cleanly when the script, python3, or origin/main is absent.
if [ -f scripts/integrity_gate.py ] && command -v python3 >/dev/null 2>&1 \
   && git rev-parse --verify -q origin/main >/dev/null 2>&1; then
  if ! python3 scripts/integrity_gate.py --staged -q; then
    if [ "${INTEGRITY_GATE_BLOCK:-0}" = "1" ]; then
      echo "✖ commit blocked: a staged record cites something not on origin/main (DRIFTED-AT-BIRTH)." >&2
      echo "  fix the cite, or merge what it cites first. Bypass once: INTEGRITY_GATE_BLOCK=0" >&2
      exit 1
    fi
    echo "⚠ pre-commit(integrity-gate): not blocking (set INTEGRITY_GATE_BLOCK=1 to enforce)." >&2
  fi
fi

# ---------------------------------------------------------------------------
# wrap-class gate for React/TS surfaces — the artifact_wrap_lint.py sibling for
# code, not just public/*.html (that gate is blind to .tsx, which is how a ch cap
# shipped on the jobs board 2026-09-08). Block a commit that ADDS a per-element
# `ch` cap on text (maxWidth: "NNch"); the rule is one shared px MEASURE. See the
# intermediate-width-wrap-regression class. Added-lines-only so legacy caps in
# untouched files never block an unrelated edit. Pure grep, no deps.
tsx=$(git diff --cached --name-only --diff-filter=ACM -- '*.tsx' '*.ts' 2>/dev/null || true)
if [ -n "$tsx" ]; then
  bad=$(git diff --cached -U0 -- '*.tsx' '*.ts' 2>/dev/null | grep -E '^\+' | grep -E 'maxWidth: *"[0-9]+ch"' || true)
  if [ -n "$bad" ]; then
    echo "✖ commit blocked: a new per-element ch cap on text (maxWidth:\"NNch\") — use the shared px MEASURE instead." >&2
    echo "$bad" | sed 's/^/  /' >&2
    echo "  (intermediate-width-wrap-regression class: ch against mixed font sizes gives each role a different right edge = broken-looking wrap.)" >&2
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# req_reality gate (manufactured-role class: Fanatics Jul-2026, HypeLab Oct-2025).
# A staged recoil SSOT for a CANDIDACY must carry opportunity.req_reality (0..3) and
# may not render y_state GREEN at <=1 (no req => no GREEN). Added-or-modified files
# only; legacy-schema SSOTs warn, never block. Deterministic, stdlib-only.
# See scripts/req_reality_gate.py and _STATE/job-search/postmortem-fanatics.md.
if [ -f scripts/req_reality_gate.py ] && command -v python3 >/dev/null 2>&1; then
  ssots=$(git diff --cached --name-only --diff-filter=ACM -- 'runtime/recoil/generated/*.json' 2>/dev/null || true)
  if [ -n "$ssots" ]; then
    if ! echo "$ssots" | tr '\n' '\0' | xargs -0 python3 scripts/req_reality_gate.py; then
      echo "✖ commit blocked: req_reality gate — a candidacy SSOT is GREEN on a req that is not real, or has no req_reality." >&2
      echo "  set opportunity.req_reality (0..3) + req_reality_basis from THEIR words; render YELLOW at <=1." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# token-source gate (re-authored-palette class, 2026-09-11): a staged single-file HTML
# surface that paints an ARCS signal hex in a custom property must inherit
# src/ui-kit/recoil-report/_tokens.css (linked, or inlined verbatim with its sentinel
# line), never re-declare the palette under its own names. Added-or-modified files;
# a file whose HEAD version already violated only WARNS (ratchet). Stdlib-only.
# See scripts/token_source_gate.py and memory arcs-fieldos-design-system.
if [ -f scripts/token_source_gate.py ] && command -v python3 >/dev/null 2>&1; then
  pages=$(git diff --cached --name-only --diff-filter=ACM -- '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 'public/*.html' 'public/**/*.html' 'src/ui-kit/**/*.html' 2>/dev/null || true)
  if [ -n "$pages" ]; then
    tmpd=$(mktemp -d); args=""
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      headf="-"
      if git cat-file -e "HEAD:$f" 2>/dev/null; then
        headf="$tmpd/$(echo "$f" | tr '/' '_')"; git show "HEAD:$f" > "$headf" 2>/dev/null || headf="-"
      fi
      args="$args $f $headf"
    done <<< "$pages"
    # shellcheck disable=SC2086
    if ! python3 scripts/token_source_gate.py --pair $args; then
      rm -rf "$tmpd"
      echo "✖ commit blocked: token-source gate — a NEW page re-authors the ARCS palette instead of inheriting _tokens.css (see above)." >&2
      echo "  inline src/ui-kit/recoil-report/_tokens.css verbatim (keep its header line) or <link> it; do not rename tokens." >&2
      exit 1
    fi
    rm -rf "$tmpd"
  fi
fi

# ---------------------------------------------------------------------------
# component-source gate (visual twin of token-source, 2026-09-26): an ENROLLED single-file
# page (one carrying  <!-- @arcs-template: <name> --> ) must assemble from the registered
# ui-kit template in src/ui-kit/templates.json — tokens inherited, @arcs-mode matching the
# template's slop --mode, and the template's signature selectors present — not a bespoke
# redesign. Un-enrolled pages PASS ("not enrolled"), so this rolls out surface-by-surface and
# does NOT touch the ~existing pages. Ratcheted via --pair (already-enrolled+failing HEAD WARNs).
# See scripts/component_source_gate.py and src/ui-kit/README.md.
if [ -f scripts/component_source_gate.py ] && command -v python3 >/dev/null 2>&1; then
  cpages=$(git diff --cached --name-only --diff-filter=ACM -- '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 'public/*.html' 'public/**/*.html' 'src/ui-kit/**/*.html' 2>/dev/null || true)
  if [ -n "$cpages" ]; then
    ctmpd=$(mktemp -d); cargs=""
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      chead="-"
      if git cat-file -e "HEAD:$f" 2>/dev/null; then
        chead="$ctmpd/$(echo "$f" | tr '/' '_')"; git show "HEAD:$f" > "$chead" 2>/dev/null || chead="-"
      fi
      cargs="$cargs $f $chead"
    done <<< "$cpages"
    # shellcheck disable=SC2086
    if ! python3 scripts/component_source_gate.py --pair $cargs; then
      rm -rf "$ctmpd"
      echo "✖ commit blocked: component-source gate — an enrolled page does not snap into its ui-kit template (see above)." >&2
      echo "  register the template in src/ui-kit/templates.json, inherit _tokens.css, match @arcs-mode, and assemble from the kit primitives; or drop the @arcs-template marker to un-enroll." >&2
      exit 1
    fi
    rm -rf "$ctmpd"
  fi
fi

# ---------------------------------------------------------------------------
# kintsugi immune system (ROM #6, visual grammar): run the Impeccable design detector over
# staged single-file pages when the launcher is installed on this machine. NEW pages block on
# any finding (contrast, eyebrow, glow, ch caps, ...). MODIFIED pages whose HEAD version already
# carried findings only WARN (ratchet). Machines without the launcher skip cleanly; the seam is
# caught on the next machine that has it. Ledger: _PATTERNS/kintsugi-visual-grammar-seams.md
IMP="$HOME/.claude/skills/impeccable/scripts/impeccable"
if [ -x "$IMP" ] && command -v python3 >/dev/null 2>&1; then
  pages=$(git diff --cached --name-only --diff-filter=ACM -- '_ARTIFACTS/*.html' 'public/*.html' 'src/ui-kit/**/*.html' 2>/dev/null || true)
  if [ -n "$pages" ]; then
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      # NB: the launcher exits non-zero WHEN IT HAS FINDINGS. Never append a fallback to its
      # output (a trailing "[]" made the JSON unparseable and the count silently 0 on 2026-09-11,
      # seam 9 in the ledger). Capture regardless of exit code; a parse failure is loud, never 0.
      out=$("$IMP" detect --json "$f" 2>/dev/null || true)
      n=$(printf '%s' "$out" | python3 -c 'import sys,json
try: print(len(json.load(sys.stdin)))
except Exception: print("ERR")' 2>/dev/null || echo ERR)
      if [ "$n" = "ERR" ]; then
        echo "⚠ pre-commit(kintsugi): could not parse detector output for $f. NOT silently passing: run '$IMP detect --json $f' by hand before you rely on this commit." >&2
        continue
      fi
      [ "${n:-0}" -eq 0 ] && continue
      if git cat-file -e "HEAD:$f" 2>/dev/null; then
        tmp=$(mktemp); git show "HEAD:$f" > "$tmp" 2>/dev/null
        hout=$("$IMP" detect --json "$tmp" 2>/dev/null || true); rm -f "$tmp"
        hn=$(printf '%s' "$hout" | python3 -c 'import sys,json
try: print(len(json.load(sys.stdin)))
except Exception: print(0)' 2>/dev/null || echo 0)
        if [ "${hn:-0}" -gt 0 ]; then
          echo "⚠ pre-commit(kintsugi): $f carries $n design finding(s); HEAD already had $hn. Not blocking (ratchet). Book the seam in _PATTERNS/kintsugi-visual-grammar-seams.md." >&2
          continue
        fi
      fi
      echo "✖ commit blocked: kintsugi immune system — $f has $n design finding(s) and its HEAD version had none (or it is new)." >&2
      printf '%s' "$out" | python3 -c 'import sys,json
for x in json.load(sys.stdin)[:8]: print("   -", x.get("name"), "·", (x.get("snippet") or "")[:90])' >&2
      echo "  fix them, book the seam (break → repair → guard) in _PATTERNS/kintsugi-visual-grammar-seams.md, re-stage." >&2
      exit 1
    done <<< "$pages"
  fi
fi

# ---------------------------------------------------------------------------
# slop guard: a customer-facing surface (resume, candidate/marketing page, outbound artifact)
# that carries high-precision AI-slop cliches (delve, leverage, spearheaded, results-driven,
# proven track record, ...) or em-dashes reads as AI-generated -- the exact failure that got a
# designed resume refused by the recruiter for the Success Academy AI PM role (2026-09-25). The
# mechanical tier-A list + em-dashes hard-fail here; structural/rhythm tells are judgment and live
# in _PATTERNS/slop-free-rubric.md, NOT this block. ADDED + MODIFIED (slop arrives via edits too);
# ratcheted against HEAD via --pair so a term already in a legacy page WARNs, only NEW slop blocks.
# Scoped to public + _ARTIFACTS html so internal docs (which legitimately discuss these words) never fail.
if [ -f scripts/slop_lint.py ] && command -v python3 >/dev/null 2>&1; then
  slop=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$slop" ]; then
    pairs=()
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      head_blob=$(mktemp)
      git show "HEAD:$f" > "$head_blob" 2>/dev/null || : > "$head_blob"
      pairs+=("$f" "$head_blob")
    done <<< "$slop"
    if ! python3 scripts/slop_lint.py --pair "${pairs[@]}"; then
      echo "✖ commit blocked: AI-slop cliche / em-dash in a customer-facing surface (see above)." >&2
      echo "  cut the tier-A terms + em-dashes; score structural tells against _PATTERNS/slop-free-rubric.md; re-stage." >&2
      for ((i=1; i<${#pairs[@]}; i+=2)); do rm -f "${pairs[$i]}" 2>/dev/null || true; done
      exit 1
    fi
    for ((i=1; i<${#pairs[@]}; i+=2)); do rm -f "${pairs[$i]}" 2>/dev/null || true; done
  fi
fi

# ---------------------------------------------------------------------------
# provenance guard: FACTUAL fabrication twin of the slop guard. A quantified claim (dollars,
# percents, latency, "N+"/"more than N") on an ENROLLED customer surface must cite an evidence.jsonl
# ledger entry; an uncovered number blocks the commit. Root cause: a "40+ demos / 75% pilot" metric
# rode a resume from session scratch with no provenance in any vetted master (2026-09-25). Opt-in:
# a file with no sibling evidence.jsonl is not enrolled (the linter skips it), so the gate rolls out
# surface-by-surface. Self-reported-by-the-subject is valid evidence (the ledger records the source).
if [ -f scripts/provenance_lint.py ] && command -v python3 >/dev/null 2>&1; then
  prov=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$prov" ]; then
    if ! echo "$prov" | tr '\n' '\0' | xargs -0 python3 scripts/provenance_lint.py; then
      echo "✖ commit blocked: a quantified claim on an enrolled surface has no evidence-ledger entry (see above)." >&2
      echo "  add each metric to the sibling evidence.jsonl with its source (vetted-master:file:line or self-reported:Name:date), or cut it." >&2
      exit 1
    fi
  fi
fi

exit 0
