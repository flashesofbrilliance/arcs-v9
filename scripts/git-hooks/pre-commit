# ---------------------------------------------------------------------------
# token-source gate (re-authored-palette class, 2026-09-11): a staged single-file HTML
# surface that paints an ARCS signal hex in a custom property must inherit
# src/ui-kit/recoil-report/_tokens.css (linked, or inlined verbatim with its sentinel
# line), never re-declare the palette under its own names. Added-or-modified files;
# a file whose HEAD version already violated only WARNS (ratchet). Stdlib-only.
# See scripts/token_source_gate.py and memory arcs-fieldos-design-system.
if [ -f scripts/token_source_gate.py ] && command -v python3 >/dev/null 2>&1; then
  pages=$(git diff --cached --name-only --diff-filter=ACM -- '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 'public/*.html' 'public/**/*.html' 'src/ui-kit/**/*.html' 2>/dev/null || true)
  if [ -n "$pages" ]; then
    tmpd=$(mktemp -d); args=""
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      headf="-"
      if git cat-file -e "HEAD:$f" 2>/dev/null; then
        headf="$tmpd/$(echo "$f" | tr '/' '_')"; git show "HEAD:$f" > "$headf" 2>/dev/null || headf="-"
      fi
      args="$args $f $headf"
    done <<< "$pages"
    # shellcheck disable=SC2086
    if ! python3 scripts/token_source_gate.py --pair $args; then
      rm -rf "$tmpd"
      echo "✖ commit blocked: token-source gate — a NEW page re-authors the ARCS palette instead of inheriting _tokens.css (see above)." >&2
      echo "  inline src/ui-kit/recoil-report/_tokens.css verbatim (keep its header line) or <link> it; do not rename tokens." >&2
      exit 1
    fi
    rm -rf "$tmpd"
  fi
fi

# ---------------------------------------------------------------------------
# component-source gate (visual twin of token-source, 2026-09-26): an ENROLLED single-file
# page (one carrying  <!-- @arcs-template: <name> --> ) must assemble from the registered
# ui-kit template in src/ui-kit/templates.json — tokens inherited, @arcs-mode matching the
# template's slop --mode, and the template's signature selectors present — not a bespoke
# redesign. Un-enrolled pages PASS ("not enrolled"), so this rolls out surface-by-surface and
# does NOT touch the ~existing pages. Ratcheted via --pair (already-enrolled+failing HEAD WARNs).
# See scripts/component_source_gate.py and src/ui-kit/README.md.
if [ -f scripts/component_source_gate.py ] && command -v python3 >/dev/null 2>&1; then
  cpages=$(git diff --cached --name-only --diff-filter=ACM -- '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 'public/*.html' 'public/**/*.html' 'src/ui-kit/**/*.html' 2>/dev/null || true)
  if [ -n "$cpages" ]; then
    ctmpd=$(mktemp -d); cargs=""
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      chead="-"
      if git cat-file -e "HEAD:$f" 2>/dev/null; then
        chead="$ctmpd/$(echo "$f" | tr '/' '_')"; git show "HEAD:$f" > "$chead" 2>/dev/null || chead="-"
      fi
      cargs="$cargs $f $chead"
    done <<< "$cpages"
    # shellcheck disable=SC2086
    if ! python3 scripts/component_source_gate.py --pair $cargs; then
      rm -rf "$ctmpd"
      echo "✖ commit blocked: component-source gate — an enrolled page does not snap into its ui-kit template (see above)." >&2
      echo "  register the template in src/ui-kit/templates.json, inherit _tokens.css, match @arcs-mode, and assemble from the kit primitives; or drop the @arcs-template marker to un-enroll." >&2
      exit 1
    fi
    rm -rf "$ctmpd"
  fi
fi

# ---------------------------------------------------------------------------
# kintsugi immune system (ROM #6, visual grammar): run the Impeccable design detector over
# staged single-file pages when the launcher is installed on this machine. NEW pages block on
# any finding (contrast, eyebrow, glow, ch caps, ...). MODIFIED pages whose HEAD version already
# carried findings only WARN (ratchet). Machines without the launcher skip cleanly; the seam is
# caught on the next machine that has it. Ledger: _PATTERNS/kintsugi-visual-grammar-seams.md
IMP="$HOME/.claude/skills/impeccable/scripts/impeccable"
if [ -x "$IMP" ] && command -v python3 >/dev/null 2>&1; then
  pages=$(git diff --cached --name-only --diff-filter=ACM -- '_ARTIFACTS/*.html' 'public/*.html' 'src/ui-kit/**/*.html' 2>/dev/null || true)
  if [ -n "$pages" ]; then
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      # NB: the launcher exits non-zero WHEN IT HAS FINDINGS. Never append a fallback to its
      # output (a trailing "[]" made the JSON unparseable and the count silently 0 on 2026-09-11,
      # seam 9 in the ledger). Capture regardless of exit code; a parse failure is loud, never 0.
      out=$("$IMP" detect --json "$f" 2>/dev/null || true)
      n=$(printf '%s' "$out" | python3 -c 'import sys,json
try: print(len(json.load(sys.stdin)))
except Exception: print("ERR")' 2>/dev/null || echo ERR)
      if [ "$n" = "ERR" ]; then
        echo "⚠ pre-commit(kintsugi): could not parse detector output for $f. NOT silently passing: run '$IMP detect --json $f' by hand before you rely on this commit." >&2
        continue
      fi
      [ "${n:-0}" -eq 0 ] && continue
      hn=0
      if git cat-file -e "HEAD:$f" 2>/dev/null; then
        # Score HEAD's blob at a path INSIDE the repo working tree, a sibling of
        # $f with the SAME extension, so the detector discovers the repo-root
        # DESIGN.md exactly as the working-file run does. TWO independent bugs
        # made HEAD misread, both fixed here:
        #   1. extension — a bare mktemp (no .html) makes `detect` infer the wrong
        #      file type and skip most rules (root-caused 2026-09-26, NFTT --dim);
        #   2. tree location — even a *.html temp OUTSIDE the repo tree (mktemp -d)
        #      cannot walk up to the repo-root DESIGN.md, so every "outside
        #      DESIGN.md" check (font-size/color/radius/font) is silently skipped.
        # Measured on public/prl-status-progress.html (HEAD): mktemp no-ext = 0,
        # mktemp -d/head.html = 7, in-tree sibling = 28 (== working). Only the
        # in-tree sibling gives an honest HEAD-vs-working comparison; fixing the
        # extension alone still HARD-BLOCKS frozen-baseline pages like public/prl-*
        # (2026-09-17, PR #486 / commit c051d3c7).
        htmp="$(dirname "$f")/.pc-kintsugi-head.$$.$(basename "$f")"
        git show "HEAD:$f" > "$htmp" 2>/dev/null || true
        hout=$("$IMP" detect --json "$htmp" 2>/dev/null || true); rm -f "$htmp"
        hn=$(printf '%s' "$hout" | python3 -c 'import sys,json
try: print(len(json.load(sys.stdin)))
except Exception: print(0)' 2>/dev/null || echo 0)
      fi
      # Count-aware ratchet. Only NET-NEW debt (working > HEAD) blocks; a page
      # that carries a frozen pre-existing baseline (a new file has HEAD=0; the
      # public/prl-* client design system is intentionally scored against a
      # repo-root DESIGN.md it was never built for, ~27 findings) ratchets on
      # its own count. A no-op / text-only edit keeps n == hn -> WARN, never
      # block. This is the design-system scope decision: the frozen baseline is
      # grandfathered per-file, and only a genuine regression trips the gate —
      # no path exemption (which would let real new debt through) and no
      # separate DESIGN.md per surface.
      if [ "${n:-0}" -gt "${hn:-0}" ]; then
        echo "✖ commit blocked: kintsugi immune system — $f has $n design finding(s), up from $hn in HEAD (net-new design debt)." >&2
        printf '%s' "$out" | python3 -c 'import sys,json
for x in json.load(sys.stdin)[:8]: print("   -", x.get("name"), "·", (x.get("snippet") or "")[:90])' >&2
        echo "  fix them, book the seam (break → repair → guard) in _PATTERNS/kintsugi-visual-grammar-seams.md, re-stage." >&2
        exit 1
      fi
      if [ "${hn:-0}" -gt 0 ]; then
        echo "⚠ pre-commit(kintsugi): $f carries $n design finding(s); HEAD had $hn. Not blocking (ratchet — pre-existing/frozen baseline). Book the seam in _PATTERNS/kintsugi-visual-grammar-seams.md." >&2
      fi
      continue
    done <<< "$pages"
  fi
fi

# ---------------------------------------------------------------------------
# receipt-timing gate (outcome-loop blindness class, 2026-09-24): a Receipt
# create path must persist the canonical `horizon` + `reviewDate` and time its
# debrief by horizon, never a blind `Date.now() + N * 86400000`. Both create
# paths wrote window/reminderDate but never horizon/reviewDate (0/249 in prod),
# so the debrief timing engine was blind. This makes a NEW blind create path
# un-committable. Added-or-modified .ts/.tsx that contain a Receipt .create(
# only. Deterministic, stdlib-only. See scripts/receipt_timing_gate.py and
# src/lib/horizon.ts.
if [ -f scripts/receipt_timing_gate.py ] && command -v python3 >/dev/null 2>&1; then
  ts_staged=$(git diff --cached --name-only --diff-filter=ACM -- 'src/**/*.ts' 'src/**/*.tsx' 'src/*.ts' 2>/dev/null || true)
  if [ -n "$ts_staged" ]; then
    create_files=""
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      [ -f "$f" ] || continue
      if grep -qE '\.receipt\.create[[:space:]]*\(' "$f"; then create_files="$create_files $f"; fi
    done <<< "$ts_staged"
    if [ -n "$create_files" ]; then
      # shellcheck disable=SC2086
      if ! python3 scripts/receipt_timing_gate.py $create_files; then
        echo "✖ commit blocked: receipt-timing gate — a Receipt create path is missing horizon/reviewDate or uses a blind T+7 reminderDate (see above)." >&2
        echo "  persist horizon: normalizeHorizon(window) + reviewDate: reviewDateForWindow(window); set reminderDate via reminderDateForWindow(window, ...). See src/lib/horizon.ts." >&2
        exit 1
      fi
    fi
  fi
fi

# ---------------------------------------------------------------------------
# slop guard: a customer-facing surface (resume, candidate/marketing page, outbound artifact)
# that carries high-precision AI-slop cliches (delve, leverage, spearheaded, results-driven,
# proven track record, ...) or em-dashes reads as AI-generated -- the exact failure that got a
# designed resume refused by the recruiter for the Success Academy AI PM role (2026-09-25). The
# mechanical tier-A list + em-dashes hard-fail here; structural/rhythm tells are judgment and live
# in _PATTERNS/slop-free-rubric.md, NOT this block. ADDED + MODIFIED (slop arrives via edits too);
# ratcheted against HEAD via --pair so a term already in a legacy page WARNs, only NEW slop blocks.
# Scoped to public + _ARTIFACTS html so internal docs (which legitimately discuss these words) never fail.
if [ -f scripts/slop_lint.py ] && command -v python3 >/dev/null 2>&1; then
  slop=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$slop" ]; then
    pairs=()
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      head_blob=$(mktemp)
      git show "HEAD:$f" > "$head_blob" 2>/dev/null || : > "$head_blob"
      pairs+=("$f" "$head_blob")
    done <<< "$slop"
    if ! python3 scripts/slop_lint.py --pair "${pairs[@]}"; then
      echo "✖ commit blocked: AI-slop cliche / em-dash in a customer-facing surface (see above)." >&2
      echo "  cut the tier-A terms + em-dashes; score structural tells against _PATTERNS/slop-free-rubric.md; re-stage." >&2
      for ((i=1; i<${#pairs[@]}; i+=2)); do rm -f "${pairs[$i]}" 2>/dev/null || true; done
      exit 1
    fi
    for ((i=1; i<${#pairs[@]}; i+=2)); do rm -f "${pairs[$i]}" 2>/dev/null || true; done
  fi
fi

# ---------------------------------------------------------------------------
# provenance guard: FACTUAL fabrication twin of the slop guard. A quantified claim (dollars,
# percents, latency, "N+"/"more than N") on an ENROLLED customer surface must cite an evidence.jsonl
# ledger entry; an uncovered number blocks the commit. Root cause: a "40+ demos / 75% pilot" metric
# rode a resume from session scratch with no provenance in any vetted master (2026-09-25). Opt-in:
# a file with no sibling evidence.jsonl is not enrolled (the linter skips it), so the gate rolls out
# surface-by-surface. Self-reported-by-the-subject is valid evidence (the ledger records the source).
if [ -f scripts/provenance_lint.py ] && command -v python3 >/dev/null 2>&1; then
  prov=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'public/**/*.html' '_ARTIFACTS/*.html' '_ARTIFACTS/**/*.html' 2>/dev/null || true)
  if [ -n "$prov" ]; then
    if ! echo "$prov" | tr '\n' '\0' | xargs -0 python3 scripts/provenance_lint.py; then
      echo "✖ commit blocked: a quantified claim on an enrolled surface has no evidence-ledger entry (see above)." >&2
      echo "  add each metric to the sibling evidence.jsonl with its source (vetted-master:file:line or self-reported:Name:date), or cut it." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# case-world drift gate (AGENTS.md #13/#15): playable case pages carry the kit's Case World
# blocks verbatim (src/ui-kit/recoil-report/15-case-world.html). Block the commit if an
# enrolled page drifted or is half-enrolled. Fix by editing the kit and running
# python3 scripts/case_world_sync.py (never hand-edit a stamped block in a page).
if [ -f scripts/case_world_sync.py ] && command -v python3 >/dev/null 2>&1; then
  cw=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'src/ui-kit/recoil-report/15-case-world.html' 2>/dev/null || true)
  if [ -n "$cw" ]; then
    if ! python3 scripts/case_world_sync.py --check >/dev/null; then
      python3 scripts/case_world_sync.py --check >&2
      echo "✖ commit blocked: a case-world page drifted from the kit (see above)." >&2
      exit 1
    fi
  fi
fi

# ---------------------------------------------------------------------------
# case-evidence gate: every number in a playable case traces to a ledger entry
# (<page>.evidence.jsonl), and every fact's quote is verified verbatim in its published source.
# Re-runs when a case page, a ledger, or a source post changes (editing a post can break a quote).
if [ -f scripts/case_evidence_lint.py ] && command -v python3 >/dev/null 2>&1; then
  ce=$(git diff --cached --name-only --diff-filter=ACM -- 'public/*.html' 'public/*.evidence.jsonl' 2>/dev/null || true)
  if [ -n "$ce" ]; then
    if ! python3 scripts/case_evidence_lint.py >/dev/null; then
      python3 scripts/case_evidence_lint.py >&2
      echo "✖ commit blocked: a case number lacks evidence or a quote no longer matches its source (see above)." >&2
      exit 1
    fi
  fi
fi


# belief-log freshness guard — if the falsification ledger (SSOT) or its emitter
# is staged, the generated view (_STATE/belief-log.md) must be regenerated in the
# same commit. A view that lags the ledger IS the open-loop-decay pathogen the
# ledger itself records (F27); this makes shipping a stale view UN-COMMITTABLE.
bl_staged=$(git diff --cached --name-only -- _STATE/falsification-ledger.jsonl scripts/belief_log_emit.py 2>/dev/null || true)
if [ -n "$bl_staged" ] && command -v python3 >/dev/null 2>&1; then
  if ! python3 scripts/belief_log_emit.py --check >/dev/null 2>&1; then
    echo "✖ pre-commit(belief-log): _STATE/belief-log.md is stale (or the ledger failed its schema audit)." >&2
    echo "  fix: run 'python3 scripts/belief_log_emit.py' and stage _STATE/belief-log.md, then re-commit." >&2
    exit 1
  fi
fi
exit 0
