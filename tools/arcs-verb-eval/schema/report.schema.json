{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://honest.arcs.care/schema/report.schema.json",
  "title": "arcs-verb-eval step report",
  "description": "What one step prints (--out / --json / export). The next step reads it via --upstream.",
  "type": "object",
  "required": ["verb", "tool", "fate", "ok", "failed", "artifact", "gates", "rubric", "floor", "sycophancy", "trace"],
  "properties": {
    "verb": {"type": "string", "enum": ["analysis", "assessment", "evaluation", "synthesis", "recapitulation"]},
    "tool": {"type": "string"},
    "fate": {"type": "string", "enum": ["sourced", "unsourced", "held", "pass", "fail", "conditional pass", "ship", "hold", "parked", "blocked"]},
    "ok": {"type": "boolean"},
    "failed": {"type": "array", "items": {"type": "string"}},
    "artifact": {"type": "string"},
    "upstream": {"type": ["string", "null"]},
    "gates": {"type": "array", "items": {
      "type": "object", "required": ["id", "ok", "evidence"],
      "properties": {"id": {"type": "string"}, "ok": {"type": "boolean"}, "evidence": {"type": "string"},
                     "ms": {"type": "number"}, "skipped": {"type": "boolean"}}}},
    "rubric": {"type": "array", "items": {
      "type": "object", "required": ["row", "label", "score", "judge"],
      "properties": {"row": {"type": "string"}, "label": {"type": "string"}, "evidence": {"type": "string"},
                     "score": {"type": ["integer", "null"], "enum": [0, 1, 2, null]}, "judge": {"type": "string"},
                     "by": {"type": "string", "enum": ["person", "model"]}, "reason": {"type": "string"}}}},
    "floor": {"type": "object", "required": ["status", "min_total", "max_total", "must_pass"],
      "properties": {"status": {"type": "string", "enum": ["pending", "pass", "fail"]}, "min_total": {"type": "integer"},
                     "max_total": {"type": "integer"}, "must_pass": {"type": "array", "items": {"type": "string"}}}},
    "sycophancy": {"type": "object", "required": ["agreement", "dissent", "ratio", "verdict", "blocking"],
      "properties": {"agreement": {"type": "integer"}, "dissent": {"type": "integer"}, "ratio": {"type": "number"},
                     "verdict": {"type": "string", "enum": ["OK", "THIN", "RETURN"]}, "blocking": {"type": "boolean"}}},
    "notes": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "array"},
    "conditions": {"type": "array"},
    "trace": {"type": "array", "items": {"type": "object", "required": ["lane", "verb"],
      "properties": {"lane": {"type": "string", "enum": ["rules", "judge", "summary"]}, "verb": {"type": "string"}}}}
  }
}
