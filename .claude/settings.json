{
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run db\\:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma studio:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx tsc:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm run verify:*)",
      "Bash(agent-browser:*)",
      "Bash(~/.npm-global/bin/agent-browser:*)",
      "Bash(npx next build)",
      "Bash(npx next build *)",
      "Bash(npx next lint)",
      "Bash(npx next lint *)",
      "Bash(vercel env ls)",
      "Bash(vercel env ls *)",
      "Bash(vercel env pull)",
      "Bash(vercel env pull *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(git push *)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(dig +short *)",
      "Bash(vercel ls)",
      "Bash(vercel inspect *)",
      "mcp__Claude_Browser__navigate",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__b00f7942-66d7-49ec-8ed2-ed4e61c5688b__get_deployment",
      "mcp__Claude_Browser__preview_start",
      "mcp__Claude_Browser__resize_window",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Preview__preview_start",
      "mcp__b00f7942-66d7-49ec-8ed2-ed4e61c5688b__list_deployments",
      "mcp__5d045ae7-5b09-4c7e-b3fe-e9e52a6b74ba__search_threads",
      "mcp__4d6d56fb-d727-457a-833d-2b8bf136e475__list_meetings",
      "mcp__4d6d56fb-d727-457a-833d-2b8bf136e475__get_meeting_transcript",
      "mcp__b00f7942-66d7-49ec-8ed2-ed4e61c5688b__web_fetch_vercel_url",
      "mcp__4d6d56fb-d727-457a-833d-2b8bf136e475__query_granola_meetings",
      "mcp__visualize__read_me",
      "mcp__Claude_Browser__find",
      "mcp__89f60db2-46c4-43d3-9d2a-b546039cd3da__get_gammas",
      "mcp__Claude_in_Chrome__navigate",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__5d045ae7-5b09-4c7e-b3fe-e9e52a6b74ba__get_thread"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-compact.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(echo \"$CLAUDE_TOOL_INPUT\" | python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('file_path',''))\" 2>/dev/null); if [[ \"$file\" == *schema.prisma ]]; then echo \"[prisma] Schema changed — run: npm run db:push (dev) or npm run db:migrate (named migration)\"; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "vercel-plugin@vercel-vercel-plugin": false
  }
}
