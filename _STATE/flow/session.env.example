# Copy to _STATE/flow/session.env (gitignored) at session start; the prepare-commit-msg hook reads it.
# ARCS_SESSION_URL: the Claude session URL (or any stable session id URL for another harness).
# ARCS_FLOW_TURNS: user turns spent so far this session — bump it as you go; honest count, not a guess.
ARCS_SESSION_URL=https://claude.ai/code/session_XXXXXXXX
ARCS_FLOW_TURNS=0
