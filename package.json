{
  "name": "arcs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio",
    "postinstall": "prisma generate",
    "db:generate": "npx prisma generate",
    "db:reset": "npx prisma migrate reset --force",
    "verify": "agent-browser open http://localhost:3000 && agent-browser wait --load networkidle && agent-browser screenshot --annotate && agent-browser open http://localhost:3000/dashboard && agent-browser wait --load networkidle && agent-browser screenshot --annotate && agent-browser close",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@auth/supabase-adapter": "^1.11.3",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.112.4",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.1",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "resend": "^6.24.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/toolbar": "^0.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "typescript": "^5"
  }
}
